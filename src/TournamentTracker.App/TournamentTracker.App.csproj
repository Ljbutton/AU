<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Tournament Tracker window for Windows: shows the app's screens (served by
    TournamentTracker.AppCore on this computer) in a WebView2 window. Published as one
    self-contained TournamentTracker.exe, so nothing else needs installing.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>TournamentTracker.App</RootNamespace>
    <AssemblyName>TournamentTracker</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Tournament Tracker</Product>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TournamentTracker.AppCore\TournamentTracker.AppCore.csproj" />
  </ItemGroup>
</Project>
