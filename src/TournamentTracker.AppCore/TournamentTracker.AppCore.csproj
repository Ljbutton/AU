<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Tournament Tracker app, minus its window: finds Among Us, installs and updates the
    mod, keeps the setup code, talks to the mod over its private connection, and serves the
    app's screens (ui/) on this computer only. The Windows app shows those screens in a
    window; everything here also runs (and is tested) on Linux.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>TournamentTracker.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ui\*.html" LogicalName="ui/%(Filename)%(Extension)" />
    <!-- Fonts, both SIL Open Font License (ui/fonts/OFL-*.txt): Amatic SC for titles, Varela Round for text. -->
    <EmbeddedResource Include="ui\fonts\*" LogicalName="ui/fonts/%(Filename)%(Extension)" />
    <!-- Crewmate heads, one per player colour (0 red … 17 coral). -->
    <EmbeddedResource Include="ui\crew\*.png" LogicalName="ui/crew/%(Filename)%(Extension)" />
    <EmbeddedResource Include="ui\logo.png" LogicalName="ui/logo.png" />
    <EmbeddedResource Include="..\..\docs\setup-codes.html" LogicalName="docs/setup-codes.html" />
    <InternalsVisibleTo Include="TournamentTracker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TournamentTracker.Core\TournamentTracker.Core.csproj" />
    <ProjectReference Include="..\TournamentTracker.Common\TournamentTracker.Common.csproj" />
  </ItemGroup>
</Project>
