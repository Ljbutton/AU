<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Red Alert: the broadcaster's app for Windows (the caster desk, OBS, replays, graphics,
    Twitch), served by TournamentTracker.Broadcast on this computer and shown in a WebView2
    window. Published as one self-contained RedAlert.exe. Its own version line (beta: 0.x),
    released as broadcast-v…. It never updates by itself: Settings → Updates installs a new version when asked.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>TournamentTracker.App</RootNamespace>
    <AssemblyName>RedAlert</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>Red Alert</Product>
    <Version>0.3.6</Version>
    <ApplicationIcon>RedAlert.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
  <ItemGroup>
    <!-- The same borderless window as The Button (one copy of the code). -->
    <Compile Include="..\TournamentTracker.App\MainForm.cs" Link="MainForm.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TournamentTracker.Broadcast\TournamentTracker.Broadcast.csproj" />
  </ItemGroup>
</Project>
