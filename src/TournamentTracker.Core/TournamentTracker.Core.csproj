<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything that does not touch the game lives here: stat tracking, scoring,
    Discord webhooks, the automute planner and dispatcher, and chat commands.
    The plugin compiles these sources straight into its own DLL, so hosts only
    install one file; this project exists so the logic can be unit-tested
    without Among Us installed.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>TournamentTracker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TournamentTracker.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The crewmate heads, for the stream overlay (the same pictures The Button uses). -->
    <EmbeddedResource Include="..\TournamentTracker.AppCore\ui\crew\*.png" LogicalName="crew/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
