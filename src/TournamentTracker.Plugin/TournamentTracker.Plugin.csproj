<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The BepInEx plugin. The core sources are compiled in directly, so the build
    produces a single TournamentTracker.dll for BepInEx/plugins.

    Game references come from the BepInEx NuGet feed. Pin the game version with
    -p:GameLibsVersion=2025.x.y to match the Among Us build you host on.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>TournamentTracker</AssemblyName>
    <RootNamespace>TournamentTracker.Plugin</RootNamespace>
    <DebugType>embedded</DebugType>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
    <GameLibsVersion Condition="'$(GameLibsVersion)' == ''">*-*</GameLibsVersion>
    <BepInExVersion Condition="'$(BepInExVersion)' == ''">6.0.0-be.735</BepInExVersion>
    <NoWarn>$(NoWarn);NU1604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\TournamentTracker.Core\**\*.cs" Exclude="..\TournamentTracker.Core\bin\**;..\TournamentTracker.Core\obj\**" LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="$(BepInExVersion)" Private="false" ExcludeAssets="runtime;native" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="$(GameLibsVersion)" PrivateAssets="all" />
    <!-- The game libs are dummy DLLs; this generates the IL2CPP interop assemblies from them at build time. -->
    <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.*-*" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
